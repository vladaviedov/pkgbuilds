From 9b46b0a0e20297da8a347e9d05ca42408535f5bd Mon Sep 17 00:00:00 2001
From: illlabs <264887968+illlabs@users.noreply.github.com>
Date: Sat, 21 Nov 2026 00:37:01 +0100
Subject: [PATCH] fix(tray): type dbusmenu layout children as av

GetLayout returns (ia{sv}av), so each item's children must be an array
of variants. _build_layout created them as a(ia{sv}av), so every child
went out as (ia{sv}a(ia{sv}av)). Strict hosts reject this: Waybar >= 0.16
drops the whole menu ("malformed or more than 1000 entries"), leaving the
tray icon unclickable.

Also stop exporting the internal "children" id list as a property of the
root item and set "children-display" = "submenu" on it instead.

Fixes #212

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 proton/vpn/app/gtk/widgets/main/tray_icon.py | 12 ++--
 tests/unit/widgets/main/test_tray_icon.py    | 70 ++++++++++++++++++++
 2 files changed, 78 insertions(+), 4 deletions(-)
 create mode 100644 tests/unit/widgets/main/test_tray_icon.py

diff --git a/proton/vpn/app/gtk/widgets/main/tray_icon.py b/proton/vpn/app/gtk/widgets/main/tray_icon.py
index e73ee1c..c609e78 100644
--- a/proton/vpn/app/gtk/widgets/main/tray_icon.py
+++ b/proton/vpn/app/gtk/widgets/main/tray_icon.py
@@ -151,12 +151,12 @@ class _DBusMenuService(dbus.service.Object):
             return (
                 dbus.Int32(parent_id),
                 dbus.Dictionary({}, signature="sv"),
-                dbus.Array([], signature="(ia{sv}av)")
+                dbus.Array([], signature="v")
             )
 
         item: dbus.Dictionary = menu[parent_id]
 
-        children = dbus.Array([], signature="(ia{sv}av)")
+        children = dbus.Array([], signature="v")
         if "children" in item:
             for child_id in item["children"]:
                 child_layout = self._build_layout(child_id, properties, menu)
@@ -164,7 +164,7 @@ class _DBusMenuService(dbus.service.Object):
                 child_props = child_layout[1] \
                     if child_layout[1] else dbus.Dictionary({}, signature="sv")
                 child_children = child_layout[2] \
-                    if child_layout[2] else dbus.Array([], signature="(ia{sv}av)")
+                    if child_layout[2] else dbus.Array([], signature="v")
                 children.append(
                     dbus.Struct(
                         (child_id_dbus, child_props, child_children),
@@ -172,7 +172,11 @@ class _DBusMenuService(dbus.service.Object):
                     )
                 )
 
-        return (dbus.Int32(parent_id), item, children)
+        props = dbus.Dictionary(
+            {k: v for k, v in item.items() if k != "children"}, signature="sv")
+        if "children" in item:
+            props["children-display"] = dbus.String("submenu")
+        return (dbus.Int32(parent_id), props, children)
 
     @dbus.service.method(
         dbus_interface=DBUSMENU_INTERFACE,
diff --git a/tests/unit/widgets/main/test_tray_icon.py b/tests/unit/widgets/main/test_tray_icon.py
new file mode 100644
index 0000000..3e3954d
--- /dev/null
+++ b/tests/unit/widgets/main/test_tray_icon.py
@@ -0,0 +1,70 @@
