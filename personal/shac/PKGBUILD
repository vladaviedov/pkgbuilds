# This PKGBUILD is not published to the AUR
# Maintainer: Vladyslav Aviedov <vladaviedov at protonmail dot com>
pkgname=shac
pkgver=0.4.0
pkgrel=1
pkgdesc="Static HTML Asset Compiler (dev)"
arch=('x86_64')
url='https://github.com/vladaviedov/shac'
license=('GPL-3.0-only')
depends=()
makedepends=('git' 'go')
source=("${pkgname}::git+https://github.com/vladaviedov/shac.git#tag=${pkgver}")
sha256sums=('SKIP')

prepare() {
	cd "${pkgname}"
	go get
}

build() {
	cd "${pkgname}"
	make release
}

package() {
	cd "${pkgname}"
	PREFIX="$pkgdir/usr" make install
}
