# This PKGBUILD is not published to the AUR
# Maintainer: Vladyslav Aviedov <vladaviedov at protonmail dot com>
pkgname=shpp
pkgver=0.9.0
pkgrel=1
pkgdesc="Static HTML Pre-Processor (dev)"
arch=('x86_64')
url='https://github.com/vladaviedov/shpp'
license=('GPL-3.0-only')
depends=()
makedepends=('git' 'go')
source=("${pkgname}::git+https://github.com/vladaviedov/shpp.git#tag=${pkgver}")
sha256sums=('SKIP')

prepare() {
	cd "${pkgname}"
	go get ./src
}

build() {
	cd "${pkgname}"
	make release
}

package() {
	cd "${pkgname}"
	PREFIX="$pkgdir/usr" make install
}
